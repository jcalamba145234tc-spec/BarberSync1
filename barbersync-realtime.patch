+
+export function useDailyAttendance(date: string, barbers: AppUser[]) {
+  const { user } = useAuth();
+  const id = user?.id;
+  const load = useCallback((cacheOnly: boolean) => getDailyAttendance(date, barbers, cacheOnly), [date, barbers, id]);
