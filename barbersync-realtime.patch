+export function useExpenses(from?: string, to?: string) {
+  const { user } = useAuth();
+  const id = user?.id;
+  const admin = user?.role === 'ADMIN';
+  const load = useCallback((cacheOnly: boolean) => admin ? getExpenses(from, to, cacheOnly) : Promise.resolve([]), [from, to, id, admin]);
