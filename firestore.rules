rules_version = '2';

// BarberSync Firestore security rules
// Security is enforced here on the server, not only by hiding buttons in the UI.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    // One read per rule evaluation. Prefer custom claims (request.auth.token.role)
    // if the extra document read ever becomes a cost problem.
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function roleIs(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role == role
        && profile().active == true;
    }

    function isAdmin() {
      return roleIs('ADMIN');
    }

    function isBarber() {
      return roleIs('BARBER');
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function shopSplit() {
      return get(/databases/$(database)/documents/settings/shop).data;
    }

    // Money fields must match the amount AND the shop's configured split,
    // so a barber cannot record a 10/90 split in their own favour.
    function validSplit(data) {
      let settings = shopSplit();
      let shopPct = settings.shopPercentage;
      let expectedShop = data.amount * shopPct;
      return data.amount is number
        && data.amount > 0
        && data.amount >= settings.minimumServicePrice
        && data.shopShare is number
        && data.barberShare is number
        && data.shopShare >= 0
        && data.barberShare >= 0
        && math.abs(data.shopShare + data.barberShare - data.amount) < 0.01
        && math.abs(data.shopShare - expectedShop) < 0.01;
    }

    // The client clock cannot be trusted: a barber could backdate a sale into
    // another reporting period. Every write must stamp serverCreatedAt with the
    // server's own time, giving an audit field that cannot be faked.
    function serverStamped(data) {
      return data.serverCreatedAt == request.time;
    }

    // ---------- users ----------
    match /users/{userId} {
      // A barber can read their own profile; the admin can read all of them.
      allow read: if isSelf(userId) || isAdmin();
      // Only the admin creates or edits staff records.
      allow create, update, delete: if isAdmin();
    }

    // ---------- services ----------
    match /services/{serviceId} {
      allow read: if isSignedIn();            // barbers need prices to log services
      allow create, update, delete: if isAdmin();
    }

    // ---------- transactions ----------
    match /transactions/{transactionId} {
      // A barber only ever reads their own transactions. The client must send a
      // matching where('barberId','==',uid) filter or the query is rejected.
      allow read: if isAdmin() || (isBarber() && resource.data.barberId == request.auth.uid);

      // A barber can create a transaction for themselves, with a correct split
      // and never pre-verified.
      allow create: if (isAdmin() && validSplit(request.resource.data)) ||
        (isBarber()
          && serverStamped(request.resource.data)
          && request.resource.data.barberId == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && validSplit(request.resource.data)
          && request.resource.data.gcashVerified == false
          && request.resource.data.status != 'CANCELLED');

      // Verifying payments, cancelling and any other edit is admin-only.
      allow update, delete: if isAdmin();
    }

    // ---------- queue ----------
    match /queue/{queueId} {
      // Fields a barber is allowed to touch on an existing entry.
      function onlyStatusFieldsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'startedAt', 'completedAt', 'estimatedWaitTime']);
      }

      allow read: if isAdmin() || isBarber();
      allow create: if isAdmin() || isBarber();
      // A barber can advance an entry but cannot reassign it to someone else
      // or rewrite the customer, service or arrival time.
      allow update: if isAdmin() || (isBarber() && onlyStatusFieldsChanged());
      allow delete: if isAdmin();
    }

    // ---------- expenses (admin only) ----------
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // ---------- shop settings ----------
    match /settings/{docId} {
      allow read: if isSignedIn();  // split % and shop name are needed by the app
      allow write: if isAdmin();
    }

    // Anything not matched above is denied by default.
  }
}
